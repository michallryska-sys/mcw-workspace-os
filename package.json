{
  "name": "mcw-workspace-os",
  "version": "1.3.0",
  "description": "MCW Workspace OS — desktop shell pre všetky MCW appky",
  "author": "Michal Ryska <michall.ryska@gmail.com>",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "dist:publish": "electron-vite build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.mcwonesolutions.workspace-os",
    "productName": "MCW Workspace OS",
    "copyright": "Copyright © 2026 MCW One Solutions",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "michallryska-sys",
          "repo": "mcw-workspace-os"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^3.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.0"
  }
}
