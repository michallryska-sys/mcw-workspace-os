{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": { "@renderer/*": ["src/renderer/src/*"] },
    "outDir": "out",
    "composite": true,
    "skipLibCheck": true
  },
  "include": ["src/renderer/src/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
